# Pelletpreis-Checker runtime configuration
# Copy for Debian/LXC: sudo install -m 600 .env.example /etc/pelletpreis-checker.env

# Web server (0.0.0.0 makes the web app reachable from your LAN)
HOST=0.0.0.0
PORT=8000
BASE_URL=http://192.168.1.136:8000
CONTACT_EMAIL=info@example.com

# E-mail alerts (SMTP)
# IONOS example: SMTP_HOST=smtp.ionos.de, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=alerts@example.com
ALERT_TO=admin@example.com

# Optional HTTP Basic Auth for the whole web app.
# Use a long random password. Required for frontend-triggered updates.
APP_USERNAME=admin
APP_PASSWORD=

# Optional: enable the "Update installieren" button in the System tab.
# Requires APP_PASSWORD and the current install/update script to have run at least once.
ALLOW_FRONTEND_UPDATE=0
UPDATE_REQUEST_FILE=/var/lib/pelletpreis-checker/update.request
